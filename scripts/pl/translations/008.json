{
"d6b91df1c0a3": "Wsparcie od kogoś bliskiego",
"3c234f34e08e": "Zła teczka",
"e76837e9967e": "Bądź przy tym",
"c47ae15370cf": "Pomóż",
"1c9c608e3229": "Obiecaj pomoc",
"598b92a23876": "Idź pomóc",
"834f63ea7a26": "Powiedz, że jutro się temu przyjrzą",
"7ec5387acdae": "Powiedz, że porozmawiamy jutro",
"ad10a62fd692": "Daj połowę",
"ccec0aa9c4cc": "Doszło, prawda",
"4e6d50bc10d3": "Nie powinieneś był pisać",
"d9076cddc38a": "Zaczęło padać. Aplikacja nałożyła trzy zamówienia. Jedno na piąte piętro, bez windy.",
"41e39f6c1f9a": "Deszcz i aplikacja",
"c1a94746e0d9": "O układzie mieszkaniowym",
"d152fa6e6e10": "Część zamienna",
"e768b53c146e": "Idź na kolację",
"be26a3c86ac1": "Przyszedł na kolację sam.",
"6614f5661bc5": "Idź na kolację sam",
"812ceadc413a": "Nie zaprzeczył, że opuścił kolację.",
"c76cf323a0e6": "Złagodził sprawę opuszczonej kolacji.",
"3f3dd0d6703d": "Gdy nowa rutyna się układa, zmienił się też twój sposób widzenia rodziny i bliskiego kręgu.",
"ac39cf553087": "Przyjął moją nową pracę bez zazdrości.",
"461d139f32e1": "Nowa praca się zaczyna",
"26d5d20e5305": "Przyjmij nowe tempo",
"2a86a93d3164": "Spotkajcie się znowu",
"d43feb72a5fc": "Powiedz, że były korki",
"36c24e444aa1": "Zapytał, jak się czujesz w zmęczony wieczór.",
"8de9841a6cd0": "Nie rozmawiał w zmęczony wieczór.",
"53c464d7093b": "Przyszedł nawet zmęczony.",
"1eb94f071283": "Zmęczenie się nazbierało",
"9cac75ac784a": "Ciężki rytm pracy i nagromadzony stres spadły w tym samym tygodniu.",
"4f45ea60fa15": "Zarządca na koniec miesiąca: „Jest protokół szkody. Porozmawiamy o kaucji”.",
"09050484b3e9": "Szef wezwał cię, żeby omówić pierwsze miesiące.",
"f5731bb7ba1c": "Szef chce, żebyś wziął trudną robotę. Twoje nazwisko będzie przez to bardziej widoczne.",
"701a97979288": "Poczekaj na fachowca od zarządcy",
"ed029e84d215": "Powiedz, żeby zgłosić to zarządcy",
"7f4d64bb1016": "Otworzyło się okno decyzji w sprawie twojego obowiązku. Możesz ułożyć wokół niego szkołę lub pracę.",
"73e8cf8b0fff": "Przejdź się, zawróć",
"c15ac015180b": "Kartka w kopercie",
"b7003777983e": "Twój staż pracy przybliża emeryturę. Musisz zdecydować, jak iść dalej, zanim zmienią się dochody i tempo.",
"56362c19ac19": "Pracuj dalej",
"e76e32917041": "Rozmawiano o tym przy herbacie, gdy cię nie było. Gdy wracasz, temat się zamyka. Ktoś: „To nic, sprawa kadrowa”.",
"63792eed0bd4": "Nazwisko przy herbacie",
"35453d0fbfa7": "Weź herbatę, wyjdź",
"c43be07cc36d": "Ścieżki wokół ciebie",
"b05a790af6f0": "Mogła się otworzyć luka między tym, jak widzi cię krąg, a życiem, które naprawdę prowadzisz.",
"7e0fb84d82fa": "Daj ćwierćzłotówkę w prezencie",
"ee413b10a603": "Wstał, gdy przyszła para.",
"804a406a9c5d": "Został przy stoliku pary.",
"a3e4ca5a4430": "Wyjdź, zjedz coś",
"0f8e6db600d7": "Wyjdź, powiedz, że nie dziś",
"8c0c80c615f9": "Wyjdź, krótko",
"8a63546e5a58": "Umorzył dług, którego nie mogłem spłacić.",
"3f5167eaf23a": "Najpierw muszę porozmawiać z rodziną",
"a01b17c3c91d": "Powiedz, że najpierw kariera",
"49fe1c5f6aaf": "Po ostatnim ostrzeżeniu wyniki wciąż są niskie. Masz ostatnią szansę, by się zebrać i utrzymać pracę.",
"f5cc4003c74d": "Nie mógł przyjść w ważny dzień.",
"4337d11f14d0": "Powiedz, że nie pamiętasz tego w ten sposób",
"d9ed810f0d1c": "Miałeś przetrwać lunch na kanapce. Szef dał jeszcze jedną robotę. 16:10, pusty żołądek.",
"a25ab181230b": "Na górze",
"e922b177ac17": "Przejdź na wyższe stanowisko",
"5a9b10e17cea": "Nagromadzone ciężkie tygodnie zaczęły zostawiać ślad na ciele i cierpliwości.",
"c95fa8c36304": "Robota, którą wziąłeś, jest skończona. Teraz musisz zdecydować, czy zamienić ją w trwalszą rolę.",
"7e8c1789e425": "Po obowiązkach, które przyjąłeś, szef słucha cię przed ostateczną decyzją.",
"879004cbcb28": "Na górze o 00:20. Krzesło. Rano masz pracę. Gdy podchodzisz do drzwi, korytarz jest pusty.",
"550c2b8765b3": "Trzy, wszystkie cicho",
"32fa7c326baf": "Porozmawiaj wprost o tej możliwości",
"07d886a60464": "Był, kiedy tego potrzebowali.",
"96df192c16aa": "Krótka wiadomość dwa dni później: „Obsadziliśmy stanowisko wewnętrznie”. Mehmet zapyta.",
"3dc279d87983": "Skrzynka jest pusta od dwóch tygodni. Jedno ogłoszenie napisało „rozpatrujemy”, potem cisza.",
"f7435a6c53c0": "Zjedliście we dwoje. Rachunek wynosi 640. Elif patrzy w telefon. Kelner czeka.",
"bfdf7a3fa24e": "Ciągnij oba",
"b517926cba96": "Skrzynka z ofertami jest pusta",
"cfc1f84d205e": "Ukrywaj związek",
"427b1d258aa6": "Jak to nazwać",
"9e29a3398a4e": "Pierwsza ocena w pracy",
"bf7b11258ccb": "Musisz zdecydować o opcji edukacji, którą oglądałeś, zanim zamknie się rejestracja.",
"a88084d13253": "Do odwołania dorzucił krótką wiadomość.",
"8d8ed6c5ad39": "Zapis nazwiska",
"a8b263cf4cf9": "Zbądź to bez podawania nazwiska",
"3562777bc6a3": "Zapytaj",
"052867e796f8": "Dał połowę tego, o co proszono.",
"dbaeb4c55b33": "Zostawił dobrą wiadomość bez odzewu.",
"c58f836d38c2": "Świętował ze mną moją dobrą wiadomość.",
"78e5a995e899": "Powiedz „dobrze dla nich” i idź dalej",
"7a49a9a42825": "Przełknij to, zostaw notatkę",
"793225294625": "Presja w pracy wzrosła",
"e40dd400b31d": "Kontynuacja znajomości z pracy",
"b42af47fad4c": "Pogratulował mi rozmowy o pracę.",
"f333f1caaedf": "Przegląd bezpieczeństwa zatrudnienia",
"6a1172ddf00f": "W pracy otworzyło się stanowisko, na którym mógłbyś wziąć więcej. Oczekuje się, że zdecydujesz w tym okresie.",
"4275c78c5ea2": "Twoje nazwisko jest na tablicy w pracy. Szef, nie patrząc: „Gdziekolwiek byłeś wczoraj, dziś jesteś tutaj”.",
"84f839cf9ca6": "Praca jest ciężka, to nie zależy ode mnie",
"e1e935f0ab9c": "Nie wspomniał w domu o zwolnieniach.",
"aa790a01e16c": "Praca, rodzina i życie prywatne wcisnęły się w ten sam tydzień. Jeśli nie postawisz granicy, każdy poprosi o trochę więcej.",
"5dc6f15871b5": "Praca, dom i bliski krąg chcą od ciebie więcej w tym samym okresie. Musisz zdecydować, jak ustawić to tempo.",
"97986d2ba96e": "Praca: „Zostań dziś”. Matka: „Jedzenie o 19:30”. Oba tego samego dnia.",
"7492d39c05ce": "Zacznij pracę",
"45f3c6d6653b": "Chciał, żebym wziął pracę.",
"7339feca39a5": "Zapisz się do pracy",
"077f1a42dc2f": "Wymów się pracą, odpuść",
"b17f13ba64d7": "Wyjdź wcześniej z pracy, idź na zajęcia",
"3ec94816c7e2": "Zadzwonił, gdy wybrałeś pracę.",
"21bb5fcb8ffa": "Powiedz, że wybrałeś pracę",
"03568021ed8f": "Powiedział, że ogarnie robotę.",
"4b47a9fbac0d": "Powiedz, że tak to nie działa",
"c04ba3ecd8bd": "Zaufanie w pracy się zachwiało",
"8fac7cc5caf5": "Zostań w pracy",
"94d7635bac17": "Wiadomość z pracy: „Jutro brakuje nam jednej osoby. Lepiej, żebyś przyszedł”. Nie zapytali, czy masz plan z Elif.",
"e45714907316": "Nie teraz",
"f58d093de4a8": "Powiedz, że teraz nie możesz tego wziąć",
"8a3ee2fa3d81": "Na razie czekaj",
"07cf494b5e7e": "Na razie odłóż",
"1fe6a37915db": "Powiedział, że na razie zostanie w domu.",
"3c8db534f2ea": "Na razie skup się na pracy",
"0635f53ce0e4": "Powiedz, że na razie zostajesz",
"8611ccc593f5": "Na razie odmów",
"29755483a5ed": "Na razie zachowaj to w tajemnicy",
"5d2487b1ae28": "Niech na razie zostanie tajemnicą",
"5ea2549e971a": "Przesadź i idź dalej",
"cbdcafcd6ebe": "Nie w tej chwili",
